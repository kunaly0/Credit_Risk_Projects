DB_HOST=localhost
DB_PORT=5432
DB_NAME=credit_risk
DB_USER=postgres
DB_PASSWORD=your_password_here

# Neon cloud serving layer
NEON_DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require  # pragma: allowlist secret

DATA_ROOT=/path/to/your/datasets

# pg_dump target for scripts/backup_db.py - keep it on a different disk from the database
BACKUP_DIR=/path/to/your/backups

FRED_API_KEY=your_fred_api_key_here
