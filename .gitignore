# Virtual environment
.venv/

# Environment files
.env
.env.*
!.env.example

# Python caches
__pycache__/
*.py[cod]

# Jupyter
.ipynb_checkpoints/

# Editor
.vscode/

# Tool caches
.ruff_cache/
.pytest_cache/

# Test/coverage output
.coverage
htmlcov/

