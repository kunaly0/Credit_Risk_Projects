Scratch/
docs/PHASE1_BLUEPRINT.md

# Project data - keep the directory structure, not the contents
data/raw/*
data/processed/*
data/interim/*
data/external/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/interim/.gitkeep
!data/external/.gitkeep
